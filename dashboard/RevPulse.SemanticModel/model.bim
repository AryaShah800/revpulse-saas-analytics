{
  "name": "RevPulse",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Customers",
        "columns": [
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "company_name",
            "dataType": "string",
            "sourceColumn": "company_name",
            "summarizeBy": "none"
          },
          {
            "name": "signup_date",
            "dataType": "dateTime",
            "sourceColumn": "signup_date",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          },
          {
            "name": "acquisition_channel",
            "dataType": "string",
            "sourceColumn": "acquisition_channel",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Customers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"customers.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers,{{\"customer_id\", type text},{\"company_name\", type text},{\"signup_date\", type date},{\"region\", type text},{\"acquisition_channel\", type text}},\"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Dates",
        "columns": [
          {
            "name": "month",
            "dataType": "dateTime",
            "sourceColumn": "month",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "month_end",
            "dataType": "dateTime",
            "sourceColumn": "month_end",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          }
        ],
        "partitions": [
          {
            "name": "Dates",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"dim_date.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers,{{\"month\", type date},{\"month_end\", type date}},\"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Plans",
        "columns": [
          {
            "name": "plan_tier",
            "dataType": "string",
            "sourceColumn": "plan_tier",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Plans",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"dim_plan.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers,{{\"plan_tier\", type text}},\"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "CustomerMonth",
        "columns": [
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "company_name",
            "dataType": "string",
            "sourceColumn": "company_name",
            "summarizeBy": "none"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          },
          {
            "name": "acquisition_channel",
            "dataType": "string",
            "sourceColumn": "acquisition_channel",
            "summarizeBy": "none"
          },
          {
            "name": "month",
            "dataType": "dateTime",
            "sourceColumn": "month",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "month_end",
            "dataType": "dateTime",
            "sourceColumn": "month_end",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "mrr_paise",
            "dataType": "double",
            "sourceColumn": "mrr_paise",
            "summarizeBy": "sum"
          },
          {
            "name": "plan_tier",
            "dataType": "string",
            "sourceColumn": "plan_tier",
            "summarizeBy": "none"
          },
          {
            "name": "opening_mrr_paise",
            "dataType": "double",
            "sourceColumn": "opening_mrr_paise",
            "summarizeBy": "sum"
          },
          {
            "name": "historical_max",
            "dataType": "double",
            "sourceColumn": "historical_max",
            "summarizeBy": "sum"
          },
          {
            "name": "movement",
            "dataType": "string",
            "sourceColumn": "movement",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "CustomerMonth",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"mart_customer_month.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers,{{\"customer_id\", type text},{\"company_name\", type text},{\"region\", type text},{\"acquisition_channel\", type text},{\"month\", type date},{\"month_end\", type date},{\"mrr_paise\", type number},{\"plan_tier\", type text},{\"opening_mrr_paise\", type number},{\"historical_max\", type number},{\"movement\", type text}},\"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "MRR INR",
            "expression": "VAR d = MAX(Dates[month]) RETURN CALCULATE(SUM(CustomerMonth[mrr_paise])/100, Dates[month]=d)",
            "formatString": "\u20b9#,##0; (\u20b9#,##0)"
          },
          {
            "name": "Active accounts",
            "expression": "VAR d = MAX(Dates[month]) RETURN CALCULATE(DISTINCTCOUNT(CustomerMonth[customer_id]),Dates[month]=d,CustomerMonth[mrr_paise]>0)",
            "formatString": "#,##0"
          },
          {
            "name": "Opening MRR INR",
            "expression": "VAR d = MAX(Dates[month]) RETURN CALCULATE(SUM(CustomerMonth[opening_mrr_paise])/100,Dates[month]=d)",
            "formatString": "\u20b9#,##0; (\u20b9#,##0)"
          },
          {
            "name": "MoM growth",
            "expression": "DIVIDE([MRR INR]-[Opening MRR INR],[Opening MRR INR])",
            "formatString": "0.0%"
          },
          {
            "name": "NRR",
            "expression": "VAR d = MAX(Dates[month]) RETURN DIVIDE(CALCULATE(SUM(CustomerMonth[mrr_paise]),Dates[month]=d,CustomerMonth[opening_mrr_paise]>0),CALCULATE(SUM(CustomerMonth[opening_mrr_paise]),Dates[month]=d))",
            "formatString": "0.0%"
          },
          {
            "name": "Customer churn",
            "expression": "VAR d = MAX(Dates[month]) RETURN DIVIDE(CALCULATE(COUNTROWS(CustomerMonth),Dates[month]=d,CustomerMonth[movement]=\"Churn\"),CALCULATE(COUNTROWS(CustomerMonth),Dates[month]=d,CustomerMonth[opening_mrr_paise]>0))",
            "formatString": "0.0%"
          },
          {
            "name": "ARPA INR",
            "expression": "DIVIDE([MRR INR],[Active accounts])",
            "formatString": "\u20b9#,##0; (\u20b9#,##0)"
          },
          {
            "name": "Overdue INR",
            "expression": "CALCULATE(SUM(Invoices[outstanding_paise])/100,Invoices[days_overdue]>0)",
            "formatString": "\u20b9#,##0; (\u20b9#,##0)"
          },
          {
            "name": "Outstanding INR",
            "expression": "SUM(Invoices[outstanding_paise])/100",
            "formatString": "\u20b9#,##0; (\u20b9#,##0)"
          },
          {
            "name": "High-risk MRR INR",
            "expression": "CALCULATE(SUM(Risk[mrr_inr]),Risk[risk_category]=\"High\")",
            "formatString": "\u20b9#,##0; (\u20b9#,##0)"
          },
          {
            "name": "Billing flags",
            "expression": "DISTINCTCOUNT(Anomalies[record_id])",
            "formatString": "#,##0"
          },
          {
            "name": "Risk accounts",
            "expression": "CALCULATE(COUNTROWS(Risk),Risk[risk_category]=\"High\")",
            "formatString": "#,##0"
          },
          {
            "name": "MRR change INR",
            "expression": "VAR d = MAX(Dates[month]) RETURN VAR s = SELECTEDVALUE(Bridge[stage]) RETURN CALCULATE(SUMX(CustomerMonth,IF(s=\"Churn\" || s=\"Contraction\",CustomerMonth[mrr_paise]-CustomerMonth[opening_mrr_paise],IF(s=\"New\" || s=\"Reactivation\",CustomerMonth[mrr_paise],CustomerMonth[mrr_paise]-CustomerMonth[opening_mrr_paise])))/100,Dates[month]=d,CustomerMonth[movement]=s)",
            "formatString": "\u20b9#,##0; (\u20b9#,##0)"
          }
        ]
      },
